{
  "name": "dsh-chatgpt-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Unofficial DSH plugin: use chatgpt.com free-tier web models as a DSH LLM provider. Strict single-flight, session binding, prompting-based tool calls.",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/local/dsh-chatgpt-web.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node scripts/test-offline.mjs",
    "build": "tsdown && node scripts/wrap-client.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsdown": "0.22.14",
    "@types/node": "24.13.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "key": "./src/client/index.ts"
    }
  }
}

{
  "name": "dsh-chatgpt-web",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Unofficial DSH plugin: use chatgpt.com free-tier web models as a DSH LLM provider. Strict single-flight, session binding, prompting-based tool calls.",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "src",
    "scripts/capture-auth.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShiYao3286/dsh-chatgpt-web.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node scripts/test-cloud.mjs",
    "build": "tsdown && node scripts/wrap-client.mjs",
    "typecheck": "tsc --noEmit",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:all": "node scripts/test-offline.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsdown": "0.22.14",
    "@types/node": "24.13.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
